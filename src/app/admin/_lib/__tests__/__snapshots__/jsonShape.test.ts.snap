  "type": "MULTIPLE_CHOICE_MULTIPLE",
  "skill": "READING",
  "difficulty": 3-4,
  "promptMd": "Which THREE of the following are mentioned?",
  "options": [
    { "contentMd": "A. Item 1", "isCorrect": true },
    { "contentMd": "B. Item 2", "isCorrect": false }
  ]
}

